# Copia este fichero a .env y ajusta lo que necesites. Todo tiene valor por defecto.

# --- Fuentes de logs ---------------------------------------------------------
HEROKU_APP=revel
# heroku-api (recomendada: streaming por la Platform API, sin CLI), heroku-cli, none.
# "auto" = heroku-api si hay token, si no heroku-cli.
LOG_SOURCES=auto
# Token de solo lectura: heroku authorizations:create -d "revel-guardia" --scope read
HEROKU_API_TOKEN=
# Ruta del ejecutable si no está en el PATH (en Windows suele bastar "heroku")
HEROKU_BIN=heroku
# Token para /api/ingest (drain de Logplex), /api/ingest/n8n y /api/ingest/raw.
# Sin token solo se acepta ingesta desde esta misma máquina.
INGEST_TOKEN=

# --- Backend Go (para el contexto de código, rutas y git blame) --------------
# Por defecto busca ~/revel_backend, ~/GolandProjects/revel_backend, ~/revel-backend
# Windows: BACKEND_PATH=C:\Users\Rushu\GolandProjects\revel_backend
BACKEND_PATH=
API_VERSION=1
ADMIN_API_VERSION=1

# --- IA local ----------------------------------------------------------------
AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Idioma de los diagnósticos y parches: es | en
AI_LANGUAGE=es
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_MS=180000
# Severidad mínima para analizar automáticamente: low | medium | high | critical
ANALYZE_MIN_SEVERITY=medium
# Parches: off | suggest (diff en el dashboard) | branch (además crea rama ai-fix/* sin tocar tu working tree)
AUTOFIX_MODE=suggest
AUTOFIX_MIN_CONFIDENCE=0.7
# gofmt para validar la sintaxis de los parches (se busca en el PATH y en ~/sdk/go*/bin)
GOFMT_BIN=

# --- Alertas por n8n (n8n/monitor-to-slack.json) -----------------------------
# Con el túnel SSH a la VM abierto (n8n VM.bat / gcloud compute ssh ... -L 5678:localhost:5678):
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/revel-guardia
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
ALERT_MIN_SEVERITY=high
# URL con la que se enlaza el dashboard desde Slack
PUBLIC_URL=

# --- Servidor y datos --------------------------------------------------------
HOST=127.0.0.1
PORT=3333
DB_FILE=data/ops_center.db
RETENTION_DAYS=14
CORRELATION_WINDOW_MS=2500
SLOW_REQUEST_MS=5000
APDEX_T_MS=500
